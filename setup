#!/usr/bin/env bash
# Onboarding entry point: runs the scripts in scripts/.
#   ./setup              pick from a menu
#   ./setup nvim mise    run the named ones
#   ./setup all          run everything
# Flags: -n/--dry-run (print only), -y/--yes (no questions), -l/--list;
# anything else starting with - goes to the scripts (./setup mise --tools)
set -euo pipefail
cd "$(dirname "$0")"

PROFILES=(nvim mise llm shell tools gnome fonts audio tidal claude)

desc() { sed -n 's/^# desc: //p' "scripts/$1.sh"; }
list() { for p in "${PROFILES[@]}"; do printf '%-6s %s\n' "$p" "$(desc "$p")"; done; }

flags=() picked=()
for arg in "$@"; do
    case "$arg" in
        -l | --list) list; exit 0 ;;
        -h | --help) sed -n '2,7s/^# \{0,1\}//p' "$0"; echo; list; exit 0 ;;
        -*) flags+=("$arg") ;; # passed on to the scripts (e.g. --tools)
        all) picked=("${PROFILES[@]}") ;;
        *)
            [ -f "scripts/$arg.sh" ] || { echo "unknown: $arg" >&2; list >&2; exit 1; }
            picked+=("$arg")
            ;;
    esac
done

if [ ${#picked[@]} -eq 0 ]; then
    [ -t 0 ] || { list; exit 1; }
    if command -v gum >/dev/null; then
        mapfile -t picked < <(list | gum choose --no-limit --header "What to set up? (space selects, enter confirms)" | awk '{print $1}')
    else
        list | nl -w2 -s'. '
        read -r -p "Numbers to run (e.g. 1 2 4): " -a nums
        for n in "${nums[@]}"; do
            [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#PROFILES[@]} ] && picked+=("${PROFILES[n - 1]}")
        done
    fi
fi
[ ${#picked[@]} -gt 0 ] || { echo "nothing picked"; exit 0; }

failed=()
for p in "${picked[@]}"; do
    bash "scripts/$p.sh" "${flags[@]}" || failed+=("$p")
done
[ ${#failed[@]} -eq 0 ] || { echo "failed: ${failed[*]}" >&2; exit 1; }
